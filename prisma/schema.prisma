// Winner Sales Tracker - Prisma schema
// Implements the V1 "Must Have" scope of the Master System Specification:
// Customer -> Opportunity -> 11-stage Pipeline, Activity timeline, Quotation
// tracking (manual entry - no live PEAK API in this build), Lost Reason,
// role-based visibility, stage/assignment history and audit log.
//
// Deliberate simplification vs. the spec: "Lead" is not a separate table.
// The spec's own Pipeline Stage 1 ("New Lead - ยังไม่ได้ติดต่อจริง") already
// defines a Lead as an Opportunity that hasn't been contacted yet, and every
// Lead field the spec lists (Lead Source, Contact Channel, Interested
// Product, Temperature) is also an Opportunity field. Modeling them as one
// entity avoids a lead-to-opportunity "conversion" step that the business
// data has no real analog for, per the spec's own "Simple for Sales"
// principle (Section 59).
//
// Postgres in production (Vercel Postgres / Neon) - see README for the
// hosted setup and deploy steps.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SALES          // ดู/แก้ไขเฉพาะของตัวเอง
  SALES_MANAGER  // ดูทีม, assign/transfer, team dashboard
  MANAGEMENT     // Executive dashboard, read-only ทุกทีม
  ADMIN          // System admin: user/master/permission/integration
}

enum CustomerType {
  NEW
  EXISTING
  REPEAT
}

enum CustomerSegment {
  RETAIL
  SME
  CORPORATE
  GOVERNMENT
  AGENCY
  CONTRACTOR
  RESELLER
  PARTNER
  OTHER
}

// Pipeline V1 - 11 stages (Section 11)
enum Stage {
  NEW_LEAD          // 1 ลูกค้าเพิ่งเข้ามา ยังไม่ได้ติดต่อจริง
  CONTACTED         // 2 ติดต่อกับลูกค้าแล้ว
  REQUIREMENT       // 3 กำลังเก็บ Requirement
  ESTIMATING        // 4 กำลังประเมินราคา
  QUOTATION_SENT    // 5 มีใบเสนอราคาแล้ว
  FOLLOW_UP         // 6 กำลังติดตามผล
  NEGOTIATION       // 7 กำลังต่อรอง
  WAITING_APPROVAL  // 8 รออนุมัติ
  WON               // 9 ลูกค้ายืนยันสั่งงาน
  LOST              // 10 ไม่ได้งาน
  ON_HOLD           // 11 หยุดโครงการชั่วคราว
}

enum Temperature {
  HOT
  WARM
  COLD
}

enum ActivityType {
  CALL
  WHATSAPP
  LINE
  FACEBOOK
  EMAIL
  MEETING
  SITE_SURVEY
  QUOTATION_SENT
  FOLLOW_UP
  NEGOTIATION
  CUSTOMER_REPLY
  INTERNAL_NOTE
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  EXPIRED
}

// Short status only - full production detail lives in WINFLOW (Section 27).
// No live WINFLOW API in this build; Sales/Admin update this manually.
enum WinflowStage {
  JOB_CREATED
  DESIGN
  PRODUCTION
  QC
  READY_FOR_DELIVERY
  DELIVERED
  INSTALLATION
  COMPLETED
}

// ---------------------------------------------------------------------------
// Org / access
// ---------------------------------------------------------------------------

model Team {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  users         User[]
  opportunities Opportunity[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(SALES)
  teamId       String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  team               Team?                @relation(fields: [teamId], references: [id])
  opportunities      Opportunity[]        @relation("SalesOwner")
  activities         Activity[]
  stageChangesMade   StageHistory[]
  assignmentsMade    AssignmentHistory[]  @relation("AssignmentChangedBy")
  assignmentsFrom    AssignmentHistory[]  @relation("AssignmentFrom")
  assignmentsTo      AssignmentHistory[]  @relation("AssignmentTo")
  auditLogEntries    AuditLog[]
}

// ---------------------------------------------------------------------------
// Masters (admin-managed)
// ---------------------------------------------------------------------------

model JobType {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  opportunities Opportunity[]
}

// "ช่องทางที่กำลังใช้คุยกับลูกค้า" (Section 8) - distinct from LeadSource.
model Channel {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  opportunities Opportunity[]
}

// "ลูกค้ามาจากไหน" (Section 7) - distinct from Channel.
model LeadSource {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  opportunities Opportunity[]
}

model LostReason {
  id        String   @id @default(cuid())
  name      String   @unique
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  opportunities Opportunity[]
}

// Default win-probability per stage (Section 19); editable by Management/Admin.
model ProbabilityConfig {
  stage   Stage @id
  percent Int
}

// ---------------------------------------------------------------------------
// Customer (Module 1, Section 5)
// ---------------------------------------------------------------------------

model Customer {
  id             String           @id @default(cuid())
  customerCode   String           @unique
  peakCustomerId String?          // manual reference until PEAK API is connected
  name           String
  companyName    String?
  customerType   CustomerType     @default(NEW)
  segment        CustomerSegment?

  contactPerson String?
  position      String?
  phone         String?
  whatsapp      String?
  line          String?
  facebook      String?
  email         String?

  address     String?
  district    String?
  province    String?
  country     String?
  mapLocation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities Opportunity[]

  @@index([name])
}

// ---------------------------------------------------------------------------
// Opportunity (Module 3, Section 9) - the core pipeline entity
// ---------------------------------------------------------------------------

model Opportunity {
  id         String @id @default(cuid())
  name       String
  customerId String

  salesOwnerId String?
  teamId       String?

  jobTypeId            String?
  description          String?
  quantity             String?
  estimatedSize        String?
  requiredDate         DateTime?
  installationRequired Boolean   @default(false)
  location             String?
  budget               Float?

  leadSourceId String?
  channelId    String?

  stage       Stage       @default(NEW_LEAD)
  temperature Temperature @default(WARM)
  probability Int         @default(10)

  estimatedValue Float?

  lastActivityDate DateTime?
  nextFollowUpDate DateTime?
  nextFollowUpTime String?
  nextAction       String?

  wonDate      DateTime?
  lostDate     DateTime?
  lostReasonId String?
  lostRemark   String?
  onHoldReason String?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer   Customer    @relation(fields: [customerId], references: [id])
  salesOwner User?       @relation("SalesOwner", fields: [salesOwnerId], references: [id])
  team       Team?       @relation(fields: [teamId], references: [id])
  jobType    JobType?    @relation(fields: [jobTypeId], references: [id])
  leadSource LeadSource? @relation(fields: [leadSourceId], references: [id])
  channel    Channel?    @relation(fields: [channelId], references: [id])
  lostReason LostReason? @relation(fields: [lostReasonId], references: [id])

  quotations        Quotation[]
  activities        Activity[]
  stageHistory      StageHistory[]
  assignmentHistory AssignmentHistory[]
  winflowJob        WinflowJob?

  @@index([stage])
  @@index([salesOwnerId])
  @@index([customerId])
  @@index([teamId])
}

// 1 Opportunity -> many Quotation (Section 22). Entered manually - Sales
// Tracker does not create quotations; PEAK is the source of truth for
// amounts, this just mirrors what was sent so pipeline value can be computed.
model Quotation {
  id            String          @id @default(cuid())
  opportunityId String
  quotationNo   String?
  quotationDate DateTime?
  amount        Float
  status        QuotationStatus @default(SENT)
  isAccepted    Boolean         @default(false)
  createdAt     DateTime        @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId])
}

// Activity timeline (Module 5, Section 16)
model Activity {
  id            String       @id @default(cuid())
  opportunityId String
  type          ActivityType
  occurredAt    DateTime     @default(now())
  createdById   String?
  note          String?
  followUpRequired Boolean   @default(false)
  nextFollowUpDate DateTime?
  createdAt     DateTime     @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation(fields: [createdById], references: [id])

  @@index([opportunityId])
}

// Stage change audit trail (Section 12)
model StageHistory {
  id            String   @id @default(cuid())
  opportunityId String
  previousStage Stage?
  newStage      Stage
  changedById   String?
  changedAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  changedBy   User?       @relation(fields: [changedById], references: [id])

  @@index([opportunityId])
}

// Sales owner transfer log (Section 29)
model AssignmentHistory {
  id            String   @id @default(cuid())
  opportunityId String
  fromUserId    String?
  toUserId      String?
  reason        String?
  changedById   String?
  changedAt     DateTime @default(now())

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromUser    User?       @relation("AssignmentFrom", fields: [fromUserId], references: [id])
  toUser      User?       @relation("AssignmentTo", fields: [toUserId], references: [id])
  changedBy   User?       @relation("AssignmentChangedBy", fields: [changedById], references: [id])

  @@index([opportunityId])
}

// Generic audit log for key field changes (Section 48)
model AuditLog {
  id            String   @id @default(cuid())
  entityType    String   // "Opportunity" | "Customer" | ...
  entityId      String
  field         String   // "stage" | "salesOwner" | "won" | "lost" | "customerLink" | ...
  previousValue String?
  newValue      String?
  changedById   String?
  changedAt     DateTime @default(now())

  changedBy User? @relation(fields: [changedById], references: [id])

  @@index([entityType, entityId])
}

// Short WINFLOW status mirror shown to Sales (Section 27). Manually updated -
// no live WINFLOW API in this build (Section 26 payload fields are captured
// as free text on creation so nothing is lost once a real integration lands).
model WinflowJob {
  id            String       @id @default(cuid())
  opportunityId String       @unique
  jobNo         String?
  stage         WinflowStage @default(JOB_CREATED)
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  opportunity Opportunity @relation(fields: [opportunityId], references: [id])
}

// Single-row config for the LINE Messaging API daily-summary notification
// (Section 47 extension - requested in addition to the in-app feed). Admin
// only; the access token is never echoed back to the browser after saving.
model IntegrationConfig {
  id                 String   @id @default("singleton")
  lineChannelToken   String?
  lineTargetId       String?
  lineDailySummaryOn Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}
