# Local dev: point at a local Postgres instance, e.g. via `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16`
# Production: use the connection string from Vercel Postgres / Neon (Storage tab in the Vercel dashboard adds this automatically)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/winner_sale_tracker"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# Optional: only needed if you wire up the daily LINE summary cron job.
# Generate the same way as SESSION_SECRET above.
CRON_SECRET="replace-with-a-random-secret-for-the-cron-endpoint"
